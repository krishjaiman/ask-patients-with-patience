# Copy this file to .env and fill in the keys for whichever provider(s) you use.
# Never commit your real .env file.

# Required only if llm.provider (or rag.embedding_provider) = openai
OPENAI_API_KEY=

# Required only if llm.provider = anthropic
ANTHROPIC_API_KEY=

# Optional: override the default config file path used by scripts/*.py
# ASKPATIENTS_CONFIG=configs/default.yaml
